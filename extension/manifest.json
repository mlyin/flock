{
  "manifest_version": 3,
  "name": "Threader — cross-list your resale inventory",
  "version": "0.2.0",
  "description": "Fills marketplace sell forms from your Threader inventory. You review every listing and submit it yourself.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://getthreader.com/*",
    "http://localhost:3737/*",
    "https://*.supabase.co/*",
    "https://www.depop.com/*",
    "https://www.mercari.com/*",
    "https://www.vinted.com/*",
    "https://www.grailed.com/*"
  ],
  "action": {
    "default_title": "Threader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://getthreader.com/*",
        "http://localhost:3737/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
