{
  "manifest_version": 3,
  "name": "Flock — cross-list your resale inventory",
  "version": "0.2.0",
  "description": "Fills marketplace sell forms from your Flock inventory. You review every listing before it goes live.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.sellonflock.com/*",
    "https://sellonflock.com/*",
    "http://localhost:3737/*",
    "https://*.supabase.co/*",
    "https://www.depop.com/*",
    "https://www.mercari.com/*",
    "https://www.vinted.com/*",
    "https://www.grailed.com/*",
    "https://poshmark.com/*",
    "https://www.facebook.com/*",
    "https://stockx.com/*"
  ],
  "action": {
    "default_title": "Flock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sellonflock.com/*",
        "https://sellonflock.com/*",
        "http://localhost:3737/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.depop.com/*"
      ],
      "js": [
        "watch-depop.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "read-depop-messages.js",
        "read-depop-listings.js"
      ],
      "matches": [
        "https://www.depop.com/*"
      ]
    }
  ]
}
