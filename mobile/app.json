{
  "expo": {
    "name": "Flock",
    "slug": "flock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "flock",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sellonflock.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Flock uses the camera to photograph garments you're listing.",
        "NSPhotoLibraryUsageDescription": "Flock uses your photo library to attach pictures of garments to a listing.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "L4M5M5385G"
    },
    "android": {
      "package": "com.sellonflock.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F8F1"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose garment photos for your Flock inventory.",
          "cameraPermission": "Photograph garments for your Flock inventory.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#12140D",
          "imageWidth": 160
        }
      ]
    ]
  }
}
