{
  "manifest_version": 3,
  "name": "Threader — cross-list to Depop and Mercari",
  "version": "0.1.0",
  "description": "Fills your Depop and Mercari sell forms from your Threader inventory. You review every listing and submit it yourself.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://getthreader.com/*",
    "http://localhost:3737/*",
    "https://*.supabase.co/*",
    "https://www.depop.com/*",
    "https://www.mercari.com/*"
  ],
  "action": {
    "default_title": "Threader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
