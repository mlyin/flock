# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# Photo identification. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses row-level security, so it must never reach the browser:
# no NEXT_PUBLIC_ prefix, and never import it into a client component.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres, used only by scripts/migrate.mjs.
# Dashboard → Connect → Session pooler. Take the pooler string, NOT "Direct
# connection" — direct is IPv6-only and will time out on an IPv4 network.
# This password is separate from the API keys above; rotating one doesn't rotate
# the other (Settings → Database → Reset password).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Optional. "fast" pins identification to the cheap model and never escalates
# to the expensive one, whatever its confidence. Leave unset for the default,
# which escalates only when brand, size or condition come back unsure.
FLOCK_INFERENCE_TIER=fast

# Optional. Which model does the first identification pass. Defaults to Haiku,
# the cheapest that reads a garment well. Sonnet costs more and is steadier on
# a small or blurry care label.
FLOCK_FAST_MODEL=claude-sonnet-5

# Optional. White-background photo cleaning, done off the seller's machine.
# Point this at your own rembg instance (docs/BACKGROUND-REMOVAL.md):
#   docker run -d -p 7000:7000 danielgatis/rembg s --host 0.0.0.0 --port 7000
# SERVER-ONLY on purpose — no NEXT_PUBLIC_ prefix. Exposing it to the browser
# would publish an unauthenticated image endpoint anyone could aim traffic at.
# Unset means the White background toggle says it isn't configured, rather than
# quietly falling back to the seller's own CPU.
BG_REMOVAL_URL=http://your-box:7000
# Defaults to isnet-general-use (Apache-2.0). Do NOT set this to a BRIA RMBG
# model — those are non-commercial and Flock is a commercial product.
BG_REMOVAL_MODEL=isnet-general-use

# Stripe. Test keys from the sandbox; live keys only when you're ready to bill.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Without this the webhook can't verify Stripe's signature and every upgrade
# is silently dropped.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (price_..., NOT prod_...) for the two paid tiers.
STRIPE_PRICE_HOGGET=price_...
STRIPE_PRICE_MUTTON=price_...

# Absolute origin, used for Stripe redirects and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=https://www.sellonflock.com

# Optional. Set to "on" once Sign in with Apple is actually configured:
# an Apple Services ID, a .p8 key uploaded to Supabase, the
# apple-developer-domain-association.txt served from the site, and the Apple
# provider enabled in Supabase Auth. Until all of that is true, leave it unset
# — the button would only ever return "Unsupported provider", which looks like
# a feature and behaves like a bug.
NEXT_PUBLIC_APPLE_SIGNIN=on

# Web push — generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Encrypts marketplace OAuth tokens before they go in the database (lib/secrets.ts).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must decode to exactly 32 bytes — a passphrase pasted here fails loudly rather
# than silently weakening AES. Keep it OUTSIDE the database: the whole point is
# that a Postgres dump alone can't act as a seller, so the two secrets have to
# be stolen from two different places. Rotating it makes existing stored tokens
# undecryptable — sellers reconnect their channels, which is the safe failure.
CHANNEL_TOKEN_KEY=
